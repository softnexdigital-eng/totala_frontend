# # Backend REST API base URL (used by Next.js server-side API route handlers)
# # For local dev: BACKEND_URL=http://localhost:5000
# # For production: BACKEND_URL=https://totala-backend.vercel.app

# # Frontend API base URL (relative -> proxies via Next.js routes which use BACKEND_URL)
# NEXT_PUBLIC_API_URL=/api


# Backend REST API base URL (used by Next.js server-side API route handlers)
BACKEND_URL=http://localhost:5000

# Frontend API base URL (relative -> proxies via Next.js routes which use BACKEND_URL)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000



# Cloudinary cloud name (Dashboard -> Product Environment -> Cloud name)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bsegqhpb
